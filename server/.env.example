# Ключ Meta Model API (придёт после приёма на хакатон)
MODEL_API_KEY=
# Порт сервера; телефон ходит на http://<IP компьютера>:8787
PORT=8787
# Supabase: состояние и файлы сервера переживают перезапуски. Без этих двух строк всё хранится в server/data.
# Секретный ключ: Supabase → Project Settings → API Keys → Secret keys (sb_secret_…)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Пространство в Supabase: на ПК — dev, на Render — main (иначе два сервера затирали бы данные друг друга)
SUPABASE_SPACE=dev
